# ─────────────────────────────────────────────────────────────────────────────
# APEX TRADER — Environment Configuration
# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────


# ── MT5: Single broker (legacy / simplest) ───────────────────────────────────
# Use these three vars if you trade through one MT5 broker only.

MT5_LOGIN=52856215
MT5_PASSWORD=8tJ!k1o0PDY0k8
MT5_SERVER=ICMarketsSC-Demo


# ── MT5: Multiple brokers ────────────────────────────────────────────────────
# Set MT5_BROKERS instead of the three vars above when you want Apex to connect
# to more than one MT5 account simultaneously (e.g. ICMarkets for forex/indices
# + Exness for crypto, or a live account + a prop-firm account).
#
# Format: JSON array. Each object needs login, password, server.
# MT5_BROKERS takes priority over MT5_LOGIN / MT5_PASSWORD / MT5_SERVER.
#
# Symbol routing: Apex checks each broker's config/brokers/<slug>.json for an
# explicit symbol mapping and routes to the first broker that has one.
# If no broker has an explicit mapping, the first connected broker is used.
# Run scripts/discover_symbols.py after adding a new broker to generate its
# config file automatically.
#
# Example — two brokers:
# MT5_BROKERS=[{"login":12345678,"password":"pw1","server":"ICMarkets-Live"},{"login":87654321,"password":"pw2","server":"Exness-Real"}]


# ── Deriv (new OAuth2 + OTP API) ─────────────────────────────────────────────
# Register an OAuth2 client at https://developers.deriv.com to obtain client_id,
# a registered HTTPS redirect_uri, and the Deriv-App-ID header value.
# Complete the OAuth2 PKCE flow once to obtain an access token (ory_at_...).
# Access tokens are short-lived (~3600s) — refresh DERIV_ACCESS_TOKEN before expiry.

DERIV_CLIENT_ID=your_deriv_oauth2_client_id
DERIV_ACCESS_TOKEN=your_deriv_access_token
DERIV_ACCOUNT_TYPE=demo
DERIV_TOKEN_EXPIRES_IN=3600
DERIV_APP_ID=your_deriv_app_id
# Optional: path to a file holding the current access token. A secret manager
# can update this file at runtime; the connector picks up the rotated token via
# its proactive-refresh callback before the old one expires (no restart needed).
DERIV_ACCESS_TOKEN_FILE=


# ── Dashboard ────────────────────────────────────────────────────────────────
# Optional. If not set, the dashboard runs without authentication (dev only).

DD_DASHBOARD_API_KEY=


# ── Monitoring ───────────────────────────────────────────────────────────────
# Optional. Datadog APM. Leave blank to disable.

DD_API_KEY=


# ── Architecture ─────────────────────────────────────────────────────────────
# Set to "true" to run the event-driven execution pipeline (Phases 1-9).
# Unset or "false" falls back to the legacy polling loop.

USE_EVENT_DRIVEN=true


# ── Trading mode ─────────────────────────────────────────────────────────────
# Toggles the instrument universe without code changes.
#   gold  (default) — Gold specialist: commodity category, XAUUSD only.
#   full            — scan all instruments across forex, commodity, index and
#                     crypto (synthetics are excluded — they need a separate
#                     Deriv broker setup).
# Any other value falls back to "gold" with a warning.

TRADING_MODE=full


# ── Environment ──────────────────────────────────────────────────────────────

APP_ENV=development


# ─────────────────────────────────────────────────────────────────────────────
# MULTI-TENANT API (Option A: process-per-user)
# Only needed when running the API control plane (`python -m api.run`). The
# per-user trading instances it spawns receive their broker credentials and
# isolated data/log directories automatically — users never touch .env.
# ─────────────────────────────────────────────────────────────────────────────

# Root for all API + per-user runtime state (DB, secrets, per-user workdirs).
# Defaults to <repo>/api_data.
APEX_API_DATA_DIR=

# Bind address for the API server.
APEX_API_HOST=127.0.0.1
APEX_API_PORT=8080

# Secrets. If unset, strong random values are generated and persisted under
# APEX_API_DATA_DIR on first run (back them up — rotating them invalidates all
# issued tokens and makes stored broker credentials undecryptable).
APEX_API_JWT_SECRET=
APEX_API_VAULT_KEY=

# Token lifetimes.
APEX_API_ACCESS_TTL_MIN=30
APEX_API_REFRESH_TTL_DAYS=7
APEX_API_RESET_TTL_MIN=30

# CORS origins for the frontend (comma-separated).
APEX_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth endpoint rate limiting (per client IP).
APEX_API_AUTH_RATE_MAX=10
APEX_API_AUTH_RATE_WINDOW=60

# Process manager.
APEX_API_MAX_INSTANCES=50
APEX_API_STOP_GRACE_SEC=15
# Python interpreter used to launch per-user instances (defaults to the API's).
APEX_API_PYTHON=

# ── Per-instance isolation (set automatically by the API; do not set manually)
# APEX_USER_ID, APEX_DATA_DIR, APEX_LOG_DIR, APEX_USER_CONFIG,
# APEX_TRADE_REPORT_DB, APEX_REPO_DIR
# See docs/DATA_JUNCTION.md for how per-user state isolation and shared,
# read-only reference data (the data junction, checkpoints) are resolved.

# ── LLM reasoning subsystem (Google Gemini / provider-agnostic) ────────────────
# Provider = Perplexity (OpenAI-compatible API). No code change to switch: the
# LLM client treats an unknown provider + a base_url as an OpenAI Chat
# Completions endpoint (Bearer auth), which is exactly Perplexity's API.
#   base_url = https://api.perplexity.ai   (NOTE: no /v1 suffix)
#   model    = sonar | sonar-pro | sonar-reasoning
#
# SECURITY — the previous Gemini key was committed here and is now EXPOSED in git
# history: REVOKE it. Do NOT paste your Perplexity key below and commit it (.env
# is tracked and the maintenance loop pushes to origin). Inject it at RUNTIME:
#     PowerShell:  $env:LLM_API_KEY = "pplx-...your-key..."
#     bash:        export LLM_API_KEY="pplx-...your-key..."
# then start APEX. The code reads os.getenv("LLM_API_KEY") so the runtime value
# wins; leaving it blank here keeps the secret out of git.
LLM_PROVIDER=perplexity
LLM_BASE_URL=https://api.perplexity.ai
LLM_API_KEY=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
LLM_MODEL=sonar
# Optional tuning (defaults shown; uncomment to override):
# DEMO: all flags ON. The LLM activates once LLM_API_KEY is present in the env
# (fail-safe no-op until then). This is a demo account.
LLM_ENABLED=true
LLM_DRIVE_DECISIONS=true
# LLM_WORKER_INTERVAL_SECONDS=60   # how often the background worker calls the model
# LLM_MAX_SYMBOLS_PER_CYCLE=8      # cap provider calls per cycle
# LLM_MIN_INTERVAL_SECONDS=30      # per-symbol throttle
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT_SECONDS=20

# ── Autonomous Action Layer (Composio) — DEMO: ON ─────────────────────────────
# Ecosystem actions only (notify / ticket / docs / reports) — never broker
# orders. Fill COMPOSIO_API_KEY to activate; blank ⇒ fail-safe mock (no external
# calls). High/destructive actions always require approval regardless of below.
COMPOSIO_ENABLED=true
COMPOSIO_DRY_RUN=false
COMPOSIO_AUTO_MAX_RISK=medium
COMPOSIO_API_KEY=ck_7TVxf7A_MGRxl1dZqyP5
# COMPOSIO_BASE_URL=https://backend.composio.dev
# COMPOSIO_ENTITY_ID=default
# Composio REST API version. v3 is current; the retired v2 endpoint returns
# HTTP 410 ("upgrade to v3"). Only change if Composio's shape changes again.
COMPOSIO_API_VERSION=v3
# Transport: "mcp" talks to Composio's MCP server (JSON-RPC over
# connect.composio.dev/mcp, authenticated with the x-consumer-api-key header) —
# the path shown in the Composio dashboard. Use "rest" for the backend REST API.
COMPOSIO_TRANSPORT=mcp
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
# Composio's MCP server exposes generic "meta" tools (COMPOSIO_MULTI_EXECUTE_TOOL,
# COMPOSIO_SEARCH_TOOLS, ...) rather than each app's action directly, so an
# app-action is dispatched THROUGH the executor meta-tool with the target slug +
# arguments. The adapter discovers the advertised tools and routes automatically;
# override these only if `python scripts/test_composio_mcp.py` shows the executor
# expects different keys than the defaults below.
# COMPOSIO_MCP_ROUTER_TOOL=COMPOSIO_MULTI_EXECUTE_TOOL
# COMPOSIO_MCP_ROUTER_TOOLS_KEY=tools
# COMPOSIO_MCP_ROUTER_SLUG_KEY=tool_slug
# COMPOSIO_MCP_ROUTER_ARGS_KEY=arguments
# Part IX v3.0 — Operational Intelligence READ layer. When enabled, the Brain's
# consolidator pulls external market context / research (and, with advisor on,
# AI advisors) through Composio as advisory Evidence. Periodic per symbol
# (cost-aware) — retrieval every N seconds, not every cycle. Advisory only:
# never a vote, never a broker order. Turn on to give the Brain a data layer.
COMPOSIO_KNOWLEDGE_ENABLED=true
COMPOSIO_ADVISOR_ENABLED=true
COMPOSIO_KNOWLEDGE_INTERVAL_SECONDS=300
COMPOSIO_KNOWLEDGE_MAX_ITEMS=5
# Connected Composio apps for this entity (CSV). Lets the Action Planner pick a
# real provider for operational capabilities (notify → gmail, docs → notion/
# googledrive, engineering.create_task → github).
COMPOSIO_AVAILABLE_PROVIDERS=composio_search,alphavantage,coinmarketcal,openrouter,gmail,notion,googledrive,github
# Preferred provider per capability ("cap=provider,…"). Knowledge/advisor
# default to reliable web search; switch to a connected market app here once its
# tool argument schema is set in COMPOSIO_KNOWLEDGE_ARG_OVERRIDES, e.g.
# COMPOSIO_PROVIDER_PREFERENCES=knowledge.retrieve=alphavantage,advisor.consult=openrouter,operator.notify=gmail
COMPOSIO_PROVIDER_PREFERENCES=operator.notify=gmail
# Optional JSON: Composio action-slug → argument template ({query}/{symbol}/
# {ticker} substituted) for a connected app's tool. Blank ⇒ safe {"query": …}.
# COMPOSIO_KNOWLEDGE_ARG_OVERRIDES={"ALPHAVANTAGE_NEWS_SENTIMENT":{"tickers":"{ticker}"},"COINMARKETCAL_GET_EVENTS":{"max":"5"}}

# ── Cognition rollout (AI Cognitive Brain gate) ───────────────────────────────
# SINGLE PATH (Constitution I.4 / III.2): the AI Cognitive Brain is the SOLE
# authority that may open trades. Legacy market-deciders (consensus / zone-thesis
# entry emitters) are severed at runtime and demoted to Evidence — there is no
# second decision path. Deterministic safety/feasibility (Part X) and position
# closing / de-risking are retained.
COGNITION_SINGLE_PATH=true
COGNITION_GATE_MODE=authoritative
# The Brain originates entries LIVE from its own reasoning (the only entry path).
# With single-path on, legacy entries are refused, so this MUST be live for the
# system to trade at all. It trades only when the Brain reasons (a valid
# LLM_API_KEY is present); otherwise it fail-safes to no entries (no reasoning ⇒
# no trade). Validate on the demo per docs/APEX_Cognition_Rollout_Runbook.md.
COGNITION_ORIGINATION_MODE=live
# How the Brain's management verdicts (EXIT/REVERSE/SCALE_OUT/PROTECT/TIGHTEN)
# reach MT5. Start in "shadow" to watch what the Brain WOULD do to open
# positions (logged, executes nothing); switch to "live" once validated so the
# Brain fully manages positions on MT5. "off" disables management entirely.
COGNITION_MANAGEMENT_MODE=live
# Event-driven "breathing": wake the Brain the instant a symbol's forming-bar
# bias flips direction or its confidence moves >= the delta, instead of only on
# the fixed cycle. The periodic cycle stays a backstop. The floor caps how often
# any one symbol can wake the Brain (bounds LLM cost); the delta filters noise.
COGNITION_EVENT_DRIVEN=true
COGNITION_EVENT_MIN_INTERVAL_SECONDS=8
COGNITION_EVENT_CONFIDENCE_DELTA=0.15

# ── Opportunity harvesting on a small account (Constitution Part V) ───────────
# The broker minimum lot (0.01) is unavoidable; on a small account it can risk
# more than the internal per-trade ceiling. Rather than rejecting every entry,
# take the opportunity at the minimum lot. The broker's own margin/min-lot floor
# stays the real hard limit. Turn OFF to restore the conservative ceiling.
RISK_ALLOW_MIN_LOT_OVER_RISK=true
