# ─────────────────────────────────────────────────────────────────────────────
# APEX TRADER — Environment Configuration
# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────


# ── MT5: Single broker (legacy / simplest) ───────────────────────────────────
# Use these three vars if you trade through one MT5 broker only.

MT5_LOGIN=52856215
MT5_PASSWORD=8tJ!k1o0PDY0k8
MT5_SERVER=ICMarketsSC-Demo


# ── MT5: Multiple brokers ────────────────────────────────────────────────────
# Set MT5_BROKERS instead of the three vars above when you want Apex to connect
# to more than one MT5 account simultaneously (e.g. ICMarkets for forex/indices
# + Exness for crypto, or a live account + a prop-firm account).
#
# Format: JSON array. Each object needs login, password, server.
# MT5_BROKERS takes priority over MT5_LOGIN / MT5_PASSWORD / MT5_SERVER.
#
# Symbol routing: Apex checks each broker's config/brokers/<slug>.json for an
# explicit symbol mapping and routes to the first broker that has one.
# If no broker has an explicit mapping, the first connected broker is used.
# Run scripts/discover_symbols.py after adding a new broker to generate its
# config file automatically.
#
# Example — two brokers:
# MT5_BROKERS=[{"login":12345678,"password":"pw1","server":"ICMarkets-Live"},{"login":87654321,"password":"pw2","server":"Exness-Real"}]


# ── Deriv (new OAuth2 + OTP API) ─────────────────────────────────────────────
# Register an OAuth2 client at https://developers.deriv.com to obtain client_id,
# a registered HTTPS redirect_uri, and the Deriv-App-ID header value.
# Complete the OAuth2 PKCE flow once to obtain an access token (ory_at_...).
# Access tokens are short-lived (~3600s) — refresh DERIV_ACCESS_TOKEN before expiry.

DERIV_CLIENT_ID=your_deriv_oauth2_client_id
DERIV_ACCESS_TOKEN=your_deriv_access_token
DERIV_ACCOUNT_TYPE=demo
DERIV_TOKEN_EXPIRES_IN=3600
DERIV_APP_ID=your_deriv_app_id
# Optional: path to a file holding the current access token. A secret manager
# can update this file at runtime; the connector picks up the rotated token via
# its proactive-refresh callback before the old one expires (no restart needed).
DERIV_ACCESS_TOKEN_FILE=


# ── Dashboard ────────────────────────────────────────────────────────────────
# Optional. If not set, the dashboard runs without authentication (dev only).

DD_DASHBOARD_API_KEY=


# ── Monitoring ───────────────────────────────────────────────────────────────
# Optional. Datadog APM. Leave blank to disable.

DD_API_KEY=


# ── Architecture ─────────────────────────────────────────────────────────────
# Set to "true" to run the event-driven execution pipeline (Phases 1-9).
# Unset or "false" falls back to the legacy polling loop.

USE_EVENT_DRIVEN=true


# ── Trading mode ─────────────────────────────────────────────────────────────
# Toggles the instrument universe without code changes.
#   gold  (default) — Gold specialist: commodity category, XAUUSD only.
#   full            — scan all instruments across forex, commodity, index and
#                     crypto (synthetics are excluded — they need a separate
#                     Deriv broker setup).
# Any other value falls back to "gold" with a warning.

TRADING_MODE=full



# ── Environment ──────────────────────────────────────────────────────────────

APP_ENV=development


# ─────────────────────────────────────────────────────────────────────────────
# MULTI-TENANT API (Option A: process-per-user)
# Only needed when running the API control plane (`python -m api.run`). The
# per-user trading instances it spawns receive their broker credentials and
# isolated data/log directories automatically — users never touch .env.
# ─────────────────────────────────────────────────────────────────────────────

# Root for all API + per-user runtime state (DB, secrets, per-user workdirs).
# Defaults to <repo>/api_data.
APEX_API_DATA_DIR=

# Bind address for the API server.
APEX_API_HOST=127.0.0.1
APEX_API_PORT=8080

# Secrets. If unset, strong random values are generated and persisted under
# APEX_API_DATA_DIR on first run (back them up — rotating them invalidates all
# issued tokens and makes stored broker credentials undecryptable).
APEX_API_JWT_SECRET=
APEX_API_VAULT_KEY=

# Token lifetimes.
APEX_API_ACCESS_TTL_MIN=30
APEX_API_REFRESH_TTL_DAYS=7
APEX_API_RESET_TTL_MIN=30

# CORS origins for the frontend (comma-separated).
APEX_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth endpoint rate limiting (per client IP).
APEX_API_AUTH_RATE_MAX=10
APEX_API_AUTH_RATE_WINDOW=60

# Process manager.
APEX_API_MAX_INSTANCES=50
APEX_API_STOP_GRACE_SEC=15
# Python interpreter used to launch per-user instances (defaults to the API's).
APEX_API_PYTHON=

# ── Per-instance isolation (set automatically by the API; do not set manually)
# APEX_USER_ID, APEX_DATA_DIR, APEX_LOG_DIR, APEX_USER_CONFIG,
# APEX_TRADE_REPORT_DB, APEX_REPO_DIR
# See docs/DATA_JUNCTION.md for how per-user state isolation and shared,
# read-only reference data (the data junction, checkpoints) are resolved.

# ── LLM reasoning subsystem (Google AI Studio — Gemini) ───────────────────────
# Provider = Google Gemini (native Gemini API). The client has a built-in
# endpoint for provider "gemini", so NO base_url is needed.
#   model = gemini-2.0-flash | gemini-2.5-flash | gemini-1.5-pro | gemini-1.5-flash
#   Get a key from Google AI Studio: https://aistudio.google.com/apikey
#
# SECURITY — the previous Perplexity key was committed here and is now EXPOSED in
# git history: REVOKE it in the Perplexity dashboard. Do NOT paste your Gemini
# key below and commit it (.env is tracked and the maintenance loop pushes to
# origin). Inject it at RUNTIME instead:
#     PowerShell:  $env:LLM_API_KEY = "AIza...your-gemini-key..."
#     bash:        export LLM_API_KEY="AIza...your-gemini-key..."
# then start APEX. The code reads os.getenv("LLM_API_KEY") so the runtime value
# wins; leaving it blank here keeps the secret out of git. (You may instead paste
# it into LLM_API_KEY below if you accept it being committed.)
LLM_PROVIDER=gemini
LLM_BASE_URL=
LLM_API_KEY=AQ.Ab8RN6Jmdd7mUVYVvjAYkUxM0qudIPKfenJKO9Xv6OWZyP3S_g
LLM_MODEL=gemini-3.6-flash
# Optional tuning (defaults shown; uncomment to override):
# DEMO: all flags ON. The LLM activates once LLM_API_KEY is present in the env
# (fail-safe no-op until then). This is a demo account.
LLM_ENABLED=true
LLM_DRIVE_DECISIONS=true
# LLM_WORKER_INTERVAL_SECONDS=60   # how often the background worker calls the model
# LLM_MAX_SYMBOLS_PER_CYCLE=8      # cap provider calls per cycle
# LLM_MIN_INTERVAL_SECONDS=30      # per-symbol throttle
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT_SECONDS=20

# ── Advisory Council — the full provider roster (Constitution Part XX/XXI/XXIII)
# The Brain consults several reasoning engines and fails over across tiers. Every
# provider below is PRE-WIRED; to activate one you ONLY paste its key into the
# matching <PROVIDER>_API_KEY var — no code, no JSON edits. A BLANK key leaves
# that provider inert (CONFIGURED, never called) and never affects the others.
# Financial growth activates providers; it never redesigns Apex (Art 15/16).
LLM_CONSULT_MULTI=true
LLM_CONSULT_MAX_ENGINES=20
# Council mode: "panel" = EVERY available advisor advises in parallel (a full
# panel; a dead one just leaves the panel, the rest keep advising — no failover
# chain). "adaptive" scales advisor count to the read's difficulty. Panel calls
# every keyed advisor each reasoning cycle — more calls/cost; switch to adaptive
# to bound it. Tier 3 (local) stays the failsafe for the Brain's own reasoner.
LLM_CONSULT_MODE=panel
LLM_MODEL_POLICY=performance
# ── Compute health / GPU constitution (§3/§7/§8/§9/§11) ───────────────────────
# Circuit breaker: a provider that fails this many times in a row is dropped from
# routing for a cooldown (exponential backoff, capped) instead of being retried —
# and its timeout paid — every cycle; it rejoins automatically on recovery.
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_CIRCUIT_COOLDOWN_MAX_SECONDS=300
# Cap concurrent LOCAL (CPU/GPU-bound) model calls so a full panel does not start
# every local model at once and exhaust the host (the "all Ollama models on → CPU
# outage" failure). 1 is safe on a CPU box; raise it once the models run on GPUs.
LLM_LOCAL_MAX_CONCURRENCY=1
# Compute class the Brain's strategic reasoner requests. Only filters when a
# model declares "classes" in LLM_EXTRA_MODELS (e.g. "classes":["deep"]); an
# untagged roster serves every request unchanged.
LLM_REASONING_COMPUTE_CLASS=deep
#
# Tier 1 — frontier commercial (highest-quality reasoning). Paste a key to arm.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=12XTnfX4UsWHdpWN0toOeq0ei5MCwcaciIejHSP5
# BluesMinds — unified OpenAI-compatible gateway (Tier 1). Paste your key here;
# blank ⇒ the roster entry stays CONFIGURED (never called) until a key is set.
BLUESMINDS_API_KEY=sk-cKQnSLXVC05GluMWchbJO61JViDLLkP72vxgobL6wfhgsA9F
# Tier 2 — hosted open-source / gateways (fast, low-cost, scalable fallback).
GROQ_API_KEY=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
OPENROUTER_API_KEY=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
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=RPZ6botzqaU8tXKcXmwSh7lXNC3zRekc
CEREBRAS_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=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
# Cloudflare Workers AI + GMI Cloud — hosted GPU inference (Tier 2) serving open
# models over OpenAI-compatible APIs. They offload the local Ollama runtime.
# Paste a key to arm; blank ⇒ the roster entry stays CONFIGURED (never called).
# Cloudflare also needs its account id — it is filled into the roster base_url
# ({CLOUDFLARE_ACCOUNT_ID}) from this env var, so no JSON edit is required.
CLOUDFLARE_API_KEY=cfat_TsgDedQOvha3HHjL1y8lVJttWFwZ0G2MhW7ZVssx6cd448b8
CLOUDFLARE_ACCOUNT_ID=192875091fe21a0ae780ce0bed2a1a55
GMI_API_KEY=
# Tier 3 — local institutional (offline, keyless). The roster ships Ollama models
# (llama3.1 / qwen2.5 / deepseek-r1 / mistral / gemma2) on :11434, a vLLM server
# on :8002 and a self-hosted NVIDIA NIM on :8001 (distinct ports — the dashboard
# owns :8000). They run only when the local server is up; no key needed. To bring
# the whole stack up as one, run  scripts\start_apex.ps1  (starts Ollama + pulls
# the models, optionally vLLM/NIM, then launches APEX). They sit last in failover
# — delete any local line you won't run.
#
# The roster the council/failover draws from. Each entry names a provider, model,
# endpoint (base_url) and tier; the api_key is intentionally OMITTED so each
# resolves the matching <PROVIDER>_API_KEY above at runtime. Adjust a model id if
# a provider retires one — no other change needed. One line (env var).
LLM_EXTRA_MODELS=[{"name":"openai","provider":"openai","model":"gpt-4o-mini","tier":1,"timeout_seconds":120},{"name":"anthropic","provider":"anthropic","model":"claude-3-5-sonnet-latest","tier":1,"timeout_seconds":120},{"name":"grok","provider":"xai","model":"grok-2-latest","base_url":"https://api.x.ai/v1","tier":1,"timeout_seconds":120},{"name":"cohere","provider":"cohere","model":"command-a-03-2025","base_url":"https://api.cohere.ai/compatibility/v1","tier":1,"timeout_seconds":120},{"name":"bluesminds","provider":"bluesminds","model":"gpt-5-mini","base_url":"https://api.bluesminds.com/v1","tier":1,"timeout_seconds":120},{"name":"groq","provider":"groq","model":"llama-3.3-70b-versatile","base_url":"https://api.groq.com/openai/v1","tier":2,"timeout_seconds":120},{"name":"openrouter","provider":"openrouter","model":"meta-llama/llama-3.1-70b-instruct","base_url":"https://openrouter.ai/api/v1","tier":2,"timeout_seconds":120},{"name":"together","provider":"together","model":"meta-llama/Llama-3.3-70B-Instruct-Turbo","base_url":"https://api.together.xyz/v1","tier":2,"timeout_seconds":120},{"name":"fireworks","provider":"fireworks","model":"accounts/fireworks/models/llama-v3p1-70b-instruct","base_url":"https://api.fireworks.ai/inference/v1","tier":2,"timeout_seconds":120},{"name":"deepinfra","provider":"deepinfra","model":"meta-llama/Meta-Llama-3.1-70B-Instruct","base_url":"https://api.deepinfra.com/v1/openai","tier":2,"timeout_seconds":120},{"name":"cerebras","provider":"cerebras","model":"gpt-oss-120b","base_url":"https://api.cerebras.ai/v1","tier":2,"classes":["fast","deep"],"context_window":131072,"timeout_seconds":120},{"name":"huggingface","provider":"huggingface","model":"meta-llama/Llama-3.1-8B-Instruct","base_url":"https://router.huggingface.co/v1","tier":2,"timeout_seconds":120},{"name":"nvidia-nim","provider":"nvidia","model":"meta/llama-3.1-70b-instruct","base_url":"https://integrate.api.nvidia.com/v1","tier":2,"timeout_seconds":120},{"name":"cloudflare","provider":"cloudflare","model":"@cf/meta/llama-3.3-70b-instruct-fp8-fast","base_url":"https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/v1","tier":2,"classes":["fast","deep"],"context_window":128000,"timeout_seconds":120},{"name":"gmi","provider":"gmi","model":"meta-llama/Llama-3.3-70B-Instruct","base_url":"https://api.gmi-serving.com/v1","tier":2,"classes":["fast","deep"],"context_window":131072,"timeout_seconds":120},{"name":"ollama-llama","provider":"ollama","model":"llama3.1","base_url":"http://localhost:11434","tier":3,"timeout_seconds":120,"classes":["fast"],"context_window":131072},{"name":"ollama-qwen","provider":"ollama","model":"qwen2.5","base_url":"http://localhost:11434","tier":3,"timeout_seconds":120,"classes":["fast","deep"],"context_window":32768},{"name":"ollama-deepseek","provider":"ollama","model":"deepseek-r1","base_url":"http://localhost:11434","tier":3,"timeout_seconds":120,"classes":["deep"],"context_window":131072},{"name":"ollama-mistral","provider":"ollama","model":"mistral","base_url":"http://localhost:11434","tier":3,"timeout_seconds":120,"classes":["fast"],"context_window":32768},{"name":"ollama-gemma","provider":"ollama","model":"gemma2","base_url":"http://localhost:11434","tier":3,"timeout_seconds":120,"classes":["fast"],"context_window":8192},{"name":"vllm-local","provider":"vllm","model":"meta-llama/Llama-3.1-8B-Instruct","base_url":"http://localhost:8002/v1","tier":3,"timeout_seconds":120,"classes":["fast"],"context_window":131072},{"name":"nvidia-nim-local","provider":"nvidia_nim_self_hosted","model":"meta/llama-3.1-8b-instruct","base_url":"http://localhost:8001/v1","tier":3,"timeout_seconds":120,"classes":["fast"],"context_window":131072}]

# ── Autonomous Action Layer (Composio) — DEMO: ON ─────────────────────────────
# Ecosystem actions only (notify / ticket / docs / reports) — never broker
# orders. Fill COMPOSIO_API_KEY to activate; blank ⇒ fail-safe mock (no external
# calls). High/destructive actions always require approval regardless of below.
COMPOSIO_ENABLED=true
COMPOSIO_DRY_RUN=false
COMPOSIO_AUTO_MAX_RISK=medium
COMPOSIO_API_KEY=ck_7TVxf7A_MGRxl1dZqyP5
# COMPOSIO_BASE_URL=https://backend.composio.dev
# COMPOSIO_ENTITY_ID=default
# Composio REST API version. v3 is current; the retired v2 endpoint returns
# HTTP 410 ("upgrade to v3"). Only change if Composio's shape changes again.
COMPOSIO_API_VERSION=v3
# Transport: "mcp" talks to Composio's MCP server (JSON-RPC over
# connect.composio.dev/mcp, authenticated with the x-consumer-api-key header) —
# the path shown in the Composio dashboard. Use "rest" for the backend REST API.
COMPOSIO_TRANSPORT=mcp
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
# Composio's MCP server exposes generic "meta" tools (COMPOSIO_MULTI_EXECUTE_TOOL,
# COMPOSIO_SEARCH_TOOLS, ...) rather than each app's action directly, so an
# app-action is dispatched THROUGH the executor meta-tool with the target slug +
# arguments. The adapter discovers the advertised tools and routes automatically;
# override these only if `python scripts/test_composio_mcp.py` shows the executor
# expects different keys than the defaults below.
# COMPOSIO_MCP_ROUTER_TOOL=COMPOSIO_MULTI_EXECUTE_TOOL
# COMPOSIO_MCP_ROUTER_TOOLS_KEY=tools
# COMPOSIO_MCP_ROUTER_SLUG_KEY=tool_slug
# COMPOSIO_MCP_ROUTER_ARGS_KEY=arguments
# Part IX v3.0 — Operational Intelligence READ layer. When enabled, the Brain's
# consolidator pulls external market context / research (and, with advisor on,
# AI advisors) through Composio as advisory Evidence. Periodic per symbol
# (cost-aware) — retrieval every N seconds, not every cycle. Advisory only:
# never a vote, never a broker order. Turn on to give the Brain a data layer.
COMPOSIO_KNOWLEDGE_ENABLED=true
COMPOSIO_ADVISOR_ENABLED=true
COMPOSIO_KNOWLEDGE_INTERVAL_SECONDS=300
COMPOSIO_KNOWLEDGE_MAX_ITEMS=5
# Connected Composio apps for this entity (CSV). Lets the Action Planner pick a
# real provider for operational capabilities (notify → gmail, docs → notion/
# googledrive, engineering.create_task → github).
COMPOSIO_AVAILABLE_PROVIDERS=composio_search,alphavantage,coinmarketcal,openrouter,gmail,notion,googledrive,github
# Preferred provider per capability ("cap=provider,…"). Knowledge → Alpha Vantage
# news/sentiment, advisor → OpenRouter, notify → Gmail. A preferred provider
# whose tool call fails (bad slug/args) fail-safes to no evidence — verify each
# app's slug + argument schema with scripts/test_composio_mcp.py.
COMPOSIO_PROVIDER_PREFERENCES=knowledge.retrieve=alphavantage,advisor.consult=openrouter,operator.notify=gmail
# Composio action-slug → argument template ({query}/{symbol}/{ticker}/{av_ticker}
# substituted; {av_ticker} = Alpha Vantage FOREX:/CRYPTO: form). Verify slugs:
# Alpha Vantage is ALPHA_VANTAGE_NEWS_SENTIMENT (underscore). Confirm CoinMarketCal
# / OpenRouter slugs+schemas the same way and adjust here — no code change needed.
COMPOSIO_KNOWLEDGE_ARG_OVERRIDES={"ALPHA_VANTAGE_NEWS_SENTIMENT":{"tickers":"{av_ticker}"},"COINMARKETCAL_GET_EVENTS":{"max":"5"}}

# ── Cognition rollout (AI Cognitive Brain gate) ───────────────────────────────
# SINGLE PATH (Constitution I.4 / III.2): the AI Cognitive Brain is the SOLE
# authority that may open trades. Legacy market-deciders (consensus / zone-thesis
# entry emitters) are severed at runtime and demoted to Evidence — there is no
# second decision path. Deterministic safety/feasibility (Part X) and position
# closing / de-risking are retained.
COGNITION_SINGLE_PATH=true
COGNITION_GATE_MODE=authoritative
# The Brain originates entries LIVE from its own reasoning (the only entry path).
# With single-path on, legacy entries are refused, so this MUST be live for the
# system to trade at all. It trades only when the Brain reasons (a valid
# LLM_API_KEY is present); otherwise it fail-safes to no entries (no reasoning ⇒
# no trade). Validate on the demo per docs/APEX_Cognition_Rollout_Runbook.md.
COGNITION_ORIGINATION_MODE=live
# How the Brain's management verdicts (EXIT/REVERSE/SCALE_OUT/PROTECT/TIGHTEN)
# reach MT5. Start in "shadow" to watch what the Brain WOULD do to open
# positions (logged, executes nothing); switch to "live" once validated so the
# Brain fully manages positions on MT5. "off" disables management entirely.
COGNITION_MANAGEMENT_MODE=live
# Event-driven "breathing": wake the Brain the instant a symbol's forming-bar
# bias flips direction or its confidence moves >= the delta, instead of only on
# the fixed cycle. The periodic cycle stays a backstop. The floor caps how often
# any one symbol can wake the Brain (bounds LLM cost); the delta filters noise.
COGNITION_EVENT_DRIVEN=true
COGNITION_EVENT_MIN_INTERVAL_SECONDS=8
# Q40 — the Brain re-reasons an OPEN position on its OWN tighter cadence than
# origination (reasoned management, not a static stop/TP). Independent throttle
# bucket on the Brain's reasoner: only open positions reason faster, so
# origination + the advisory council keep the global rate (no extra panel cost
# across the scanned universe). Safe with a fast primary model (gemini flash).
COGNITION_MANAGE_MIN_INTERVAL_SECONDS=8
# Lowered 0.15 → 0.10 so smaller but still meaningful forming-bar shifts wake
# the Brain (more responsive entries/management). Extra wakes hit the per-symbol
# reasoner throttle, so no extra provider calls across scanning.
COGNITION_EVENT_CONFIDENCE_DELTA=0.10
# Reason over the FULL enabled universe each periodic cycle (default 12 only
# covered the first 12 symbols; the loop now round-robins, but this makes every
# symbol reasoned every cycle). Closed instruments are gated out cheaply before
# any LLM call, so the real per-cycle cost is only the OPEN symbols.
COGNITION_MAX_SYMBOLS_PER_CYCLE=64
# Part XIX Art 1/7/8 — opportunity qualification (presume noise). An originated
# entry / scale only proceeds if its expected NET value after real round-trip
# cost (spread + commission + slippage) is positive. cost_multiple applies Art 8
# ("would I still take this if costs doubled?"). This stops the churn where many
# tiny entries lose to spread/commission. commission_per_lot=0 self-calibrates
# from realised closed deals. Set enabled=false only to disable the gate.
COGNITION_OPPORTUNITY_QUALIFICATION_ENABLED=true
COGNITION_OPPORTUNITY_COST_MULTIPLE=2.0
COGNITION_OPPORTUNITY_MIN_NET_EV=0.0
COGNITION_COMMISSION_PER_LOT_ROUND_TRIP=0.0

# ── Opportunity harvesting on a small account (Constitution Part V) ───────────
# The broker minimum lot (0.01) is unavoidable; on a small account it can risk
# more than the internal per-trade ceiling. Rather than rejecting every entry,
# take the opportunity at the minimum lot. The broker's own margin/min-lot floor
# stays the real hard limit. Turn OFF to restore the conservative ceiling.
RISK_ALLOW_MIN_LOT_OVER_RISK=true
