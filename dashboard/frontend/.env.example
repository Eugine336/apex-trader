# ── Apex Trader dashboard frontend (Vite) ────────────────────────────────────
# Copy to `dashboard/frontend/.env` and fill in. Only VITE_-prefixed vars are
# exposed to the browser bundle. `.env` is gitignored.

# Optional. Base URL for the API (leave blank to use the same origin the
# dashboard is served from).
VITE_API_URL=

# Optional build-time fallback for the dashboard API key. You normally do NOT
# need this — paste the key at runtime on the Controls page instead (stored in
# the browser, no rebuild). If set, it must MATCH the backend DD_DASHBOARD_API_KEY.
# NOTE: a value set here is baked into the browser bundle at build time — it is
# not a true secret in the client. Fine for a single-user/localhost dashboard.
VITE_DASHBOARD_API_KEY=
