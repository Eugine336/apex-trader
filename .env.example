# Copy this file to .env and fill in credentials locally. Never commit .env.

# Broker credentials
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
DERIV_CLIENT_ID=
DERIV_ACCESS_TOKEN=
DERIV_APP_ID=your_deriv_app_id
DERIV_ACCOUNT_TYPE=demo
DERIV_ACCESS_TOKEN_FILE=

# Runtime and data paths
USE_EVENT_DRIVEN=true
TRADING_MODE=full
APP_ENV=development
APEX_API_DATA_DIR=
APEX_API_HOST=
APEX_API_PORT=8080

# LLM / adviser: configure a supported provider and its key or local endpoint
LLM_PROVIDER=gemini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLED=true
LLM_DRIVE_DECISIONS=true
LLM_MAX_SYMBOLS_PER_CYCLE=12       # cap provider calls per cycle; remote H100 can sustain broader scans
LLM_MIN_INTERVAL_SECONDS=15        # per-symbol throttle; cloud providers still self-rate-limit via breaker/backoff
LLM_TIMEOUT_SECONDS=30
LLM_CONSULT_MULTI=true
LLM_CONSULT_MAX_ENGINES=2
LLM_CONSULT_MODE=panel
LLM_MODEL_POLICY=

# Optional provider keys (leave blank unless used)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
BLUESMINDS_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
CEREBRAS_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
GMI_API_KEY=
MODAL_INFERENCE_KEY=

# Cognition identity defaults
COGNITION_SINGLE_PATH=true
COGNITION_GATE_MODE=authoritative
COGNITION_ORIGINATION_MODE=live
COGNITION_MANAGEMENT_MODE=live
COGNITION_EV_PRIMARY_GATE=true
COGNITION_EVENT_DRIVEN=true
COGNITION_EVENT_MIN_INTERVAL_SECONDS=1
COGNITION_MANAGE_MIN_INTERVAL_SECONDS=8
COGNITION_EVENT_CONFIDENCE_DELTA=0.10
COGNITION_MAX_SYMBOLS_PER_CYCLE=12
COGNITION_MIN_ADVISORS_FOR_ACTION=1
COGNITION_MIN_EVIDENCE_DOMAINS=3
COGNITION_OPPORTUNITY_QUALIFICATION_ENABLED=true
COGNITION_OPPORTUNITY_COST_MULTIPLE=2.0
COGNITION_OPPORTUNITY_MIN_NET_EV=0.0
COGNITION_COMMISSION_PER_LOT_ROUND_TRIP=0.0

# Risk and dashboard credentials
MAX_SIMULTANEOUS_POSITIONS=3
MAX_ACCOUNT_RISK_PERCENT=1.0
RISK_ALLOW_MIN_LOT_OVER_RISK=true
DD_DASHBOARD_API_KEY=
DD_API_KEY=
APEX_API_JWT_SECRET=
APEX_API_VAULT_KEY=
CHATGPT_RELAY_TOKEN=

# Optional integrations
COMPOSIO_ENABLED=true
COMPOSIO_API_KEY=
COMPOSIO_API_VERSION=v3
COMPOSIO_TRANSPORT=mcp
COMPOSIO_MCP_URL=
COMPOSIO_KNOWLEDGE_ENABLED=true
COMPOSIO_ADVISOR_ENABLED=true
COMPOSIO_KNOWLEDGE_INTERVAL_SECONDS=300
COMPOSIO_KNOWLEDGE_MAX_ITEMS=5
COMPOSIO_AVAILABLE_PROVIDERS=composio_search,alphavantage,coinmarketcal,openrouter,gmail,notion,googledrive,github
COMPOSIO_PROVIDER_PREFERENCES=knowledge.retrieve=alphavantage,advisor.consult=openrouter,operator.notify=gmail
COMPOSIO_KNOWLEDGE_ARG_OVERRIDES=

# Keep automated trading disabled for optional Binance adapter unless explicitly tested
BINANCE_EXECUTION_MODE=PAPER
BINANCE_LIVE_EXECUTION_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MAX_NOTIONAL_USDT=100
BINANCE_FUTURES_BASE_URL=

DERIV_TOKEN_EXPIRES_IN=
APEX_API_ACCESS_TTL_MIN=30
APEX_API_REFRESH_TTL_DAYS=7
APEX_API_RESET_TTL_MIN=30
APEX_API_CORS_ORIGINS=
APEX_API_AUTH_RATE_MAX=10
APEX_API_AUTH_RATE_WINDOW=60
APEX_API_MAX_INSTANCES=50
APEX_API_STOP_GRACE_SEC=15
APEX_API_PYTHON=
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_CIRCUIT_COOLDOWN_MAX_SECONDS=300
LLM_LOCAL_MAX_CONCURRENCY=2
LLM_REASONING_COMPUTE_CLASS=deep
LLM_RECOVERY_PROBE_SECONDS=60
LIGHTNING_OLLAMA_URL=
LLM_EXTRA_MODELS=[{"name":"ollama-deep","provider":"ollama","model":"qwen3.5:14b","tier":3,"classes":["deep"],"context_window":32768,"base_url":"http://localhost:11434/v1"},{"name":"vllm-deep","provider":"vllm","model":"Qwen/Qwen3.5-14B","tier":3,"classes":["deep"],"context_window":32768,"base_url":"http://localhost:8000/v1"},{"name":"cloudflare","provider":"cloudflare","model":"@cf/meta/llama-3.3-70b-instruct-fp8-fast","base_url":"https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/v1","tier":2,"classes":["fast","general"],"context_window":8192,"timeout_seconds":30},{"name":"gmi","provider":"gmi","model":"deepseek-ai/DeepSeek-R1","base_url":"https://api.gmi-serving.com/v1","tier":2,"classes":["deep"],"context_window":65536,"timeout_seconds":90}]
COMPOSIO_DRY_RUN=false
COMPOSIO_AUTO_MAX_RISK=medium
CHATGPT_RELAY_HOST=
CHATGPT_RELAY_PORT=8790
CHATGPT_SIGNAL_TIMEOUT_SECONDS=90
CHATGPT_ALLOW_DUPLICATES=false
