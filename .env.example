# APEX TRADER environment template
# Copy to .env and fill in real credentials on the machine that runs Apex.
# NEVER commit .env or place real tokens/passwords in this file.
#
# This template selects Gold-only trading and the CognitiveBrain's live
# origination/management path, with canonical identity and risk gates enforced.
# No broker can trade until valid credentials, broker reconciliation, market
# evidence, opportunity qualification, and the execution risk gates all pass.

# See docs/CONFIGURATION_REFERENCE.md for the complete control contract.
# All literal runtime environment reads are covered by
# tests/test_env_example_coverage.py.
# =============================================================================
# 1. Runtime mode and paths
APEX_LOG_LEVEL=INFO
# Optional bootstrap overrides for the canonical owner-editable capital limits.
# Only fields accepted by OwnerLimits.apply_updates are allowed; internal hard
# stops and immutable safety ceilings cannot be changed through this variable.
# Example: {"risk_per_trade_pct":0.5,"max_open_positions":3,"daily_loss_limit_pct":2.0}
APEX_OWNER_LIMITS_JSON=
# =============================================================================
USE_EVENT_DRIVEN=true
# Trading universe: gold (XAUUSD only), full (all configured categories),
# selected (TRADING_SYMBOLS list), or single (exactly one TRADING_SYMBOLS entry).
TRADING_MODE=gold
# true makes the process-level universe override persisted per-user universe preferences.
TRADING_MODE_LOCKED=true
TRADING_ENABLED=true
TRADING_SYMBOLS=
# Comma-separated categories used only with TRADING_MODE=full.
TRADING_ENABLED_CATEGORIES=forex,commodity,index,crypto
MAX_TICK_AGE_SECONDS=120
APEX_MARKET_CLOSED_TICK_AGE_SECONDS=900

# Mutable trading state must live OUTSIDE the source-code Git work tree or in
# the correctly provisioned data-repository junction. This relative path is
# resolved from the process working directory; run main.py from the repo root
# or replace it with an absolute path for your host.
APEX_DATA_DIR=../apex-trader-data
APEX_LOG_DIR=
APEX_REPO_DIR=
APEX_USER_ID=
APEX_USER_CONFIG=
APEX_TRADE_REPORT_DB=

# Event-driven execution performance and management scheduling.
# Set either to 0 only as an operational rollback switch.
APEX_ED_POSEVAL_PARALLEL=1
APEX_ED_EVENT_REACTIVE_MGMT=1

# Read-only Gold Desk observer. It publishes evidence only; it has no
# independent order-submission path. AUTO resolves the venue per symbol.
APEX_GOLD_DESK_SHADOW_ENABLED=1
APEX_GOLD_DESK_VENUE=AUTO

# =============================================================================
# 2. Broker credentials and account selection
# =============================================================================
# Multi-broker MT5 JSON takes priority over the legacy single-account fields.
# Example (replace every value; do not put real credentials in this template):
# MT5_BROKERS=[{"login":12345678,"password":"replace-me","server":"Broker-Live"}]
MT5_BROKERS=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=JustMarkets-Demo
# Optional exact executable path to pin Python to an installed MT5 terminal.
# Leave blank for the package automatic terminal discovery.
MT5_TERMINAL_PATH=


DERIV_CLIENT_ID=
DERIV_ACCESS_TOKEN=
DERIV_APP_ID=
# Set to "real" for the requested live account; the OAuth token must be
# authorized for a real account. Use "demo" only when intentionally testing.
DERIV_ACCOUNT_TYPE=real
# Optional mounted token file for rotation. If set and readable, refresh uses it.
DERIV_ACCESS_TOKEN_FILE=
# Access-token lifetime in seconds. Blank or invalid values also fall back safely to 3600.
DERIV_TOKEN_EXPIRES_IN=3600

# =============================================================================
# 3. Identity, cognition, and live execution mode
# =============================================================================
COGNITION_ENABLED=true
COGNITION_SHADOW_MODE=false
COGNITION_GATE_MODE=authoritative
COGNITION_SINGLE_PATH=true
COGNITION_ORIGINATION_MODE=live
COGNITION_MANAGEMENT_MODE=live
COGNITION_MEMORY_ENABLED=true
COGNITION_OPERATIONS_ENABLED=false
COGNITION_INFLUENCE_ENABLED=false
COGNITION_INFLUENCE_WEIGHTING_ENABLED=false

# Identity invariants: Brain is the sole market decision authority and
# positive net-EV qualification is mandatory. There is no universal evidence-
# domain count floor; candidate-specific evidence and provenance remain required.
# COGNITION_MIN_ADVISORS_FOR_ACTION is an advisor quorum, not a domain count.
COGNITION_EV_PRIMARY_GATE=true
COGNITION_EV_ACTION_THRESHOLD_R=0.0
COGNITION_OPPORTUNITY_QUALIFICATION_ENABLED=true
COGNITION_MIN_ADVISORS_FOR_ACTION=1
COGNITION_DEGRADE_ON_UNKNOWN_COUNCIL=true
COGNITION_PER_MODULE_EVIDENCE=true
COGNITION_EMIT_OPERATOR_NOTIFICATIONS=true

# Loop cadence and live opportunity/management settings.
COGNITION_LOOP_INTERVAL_SECONDS=30
COGNITION_MAX_DECISION_AGE_SECONDS=300
COGNITION_MAX_SYMBOLS_PER_CYCLE=12
COGNITION_EVENT_DRIVEN=true
COGNITION_EVENT_MIN_INTERVAL_SECONDS=1
COGNITION_MANAGE_MIN_INTERVAL_SECONDS=8
COGNITION_ALLOW_SCALE_IN=false
# Risk fraction is fractional account risk (0.005 = 0.5%); keep it within the
# independently enforced Layer-2 per-trade and whole-book risk budget.
COGNITION_ORIGINATION_RISK_FRACTION=0.005
COGNITION_ORIGINATION_MAX_EXPOSURE=1.0
COGNITION_ORIGINATION_MAX_LOTS=0.0
COGNITION_OPPORTUNITY_COST_MULTIPLE=2.0
COGNITION_OPPORTUNITY_MIN_NET_EV=0.0
# Set the broker's actual round-trip commission per lot in account currency.
# Zero commission is treated as unknown unless the broker explicitly confirms it.
COGNITION_COMMISSION_PER_LOT_ROUND_TRIP=0.0
COGNITION_COMMISSION_MODEL_VERIFIED=false
# Per-symbol round-trip financing estimate per 1 lot in account currency, for the expected holding horizon.
# Example: {"XAUUSD": 4.5, "EURUSD": 1.2}. Empty/missing symbols fail net-EV qualification closed.
COGNITION_FINANCING_PER_LOT_ROUND_TRIP_JSON={}
COGNITION_FINANCING_MODEL_VERIFIED=false

# Explicitly retain the conservative risk configuration: do not inflate a
# minimum lot beyond the risk budget and do not silently restore legacy exits.
RISK_ALLOW_MIN_LOT_OVER_RISK=false
RISK_SCAN_DIRECTIONAL_EXITS_ENABLED=false
RISK_LEGACY_MECHANICAL_EXIT_FALLBACK_ENABLED=false

# =============================================================================
# 4. Primary LLM adviser and provider resilience
# =============================================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_ENABLED=true
LLM_DRIVE_DECISIONS=true
LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=1024  # source default; uncomment only if overriding it
LLM_TEMPERATURE=0.2
LLM_MIN_INTERVAL_SECONDS=15
LLM_WORKER_INTERVAL_SECONDS=60
LLM_MAX_SYMBOLS_PER_CYCLE=12
LLM_EXTRA_MODELS=[{"name":"ollama-deep","provider":"ollama","model":"qwen3.5:14b","tier":3,"classes":["deep"],"context_window":32768,"base_url":"http://localhost:11434/v1"},{"name":"vllm-deep","provider":"vllm","model":"Qwen/Qwen3.5-14B","tier":3,"classes":["deep"],"context_window":32768,"base_url":"http://localhost:8000/v1"},{"name":"cloudflare","provider":"cloudflare","model":"@cf/meta/llama-3.3-70b-instruct-fp8-fast","base_url":"https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/v1","tier":2,"classes":["fast","general"],"context_window":8192,"timeout_seconds":30},{"name":"gmi","provider":"gmi","model":"deepseek-ai/DeepSeek-R1","base_url":"https://api.gmi-serving.com/v1","tier":2,"classes":["deep"],"context_window":65536,"timeout_seconds":90}]
LLM_MODEL_POLICY=performance
LLM_CONSULT_MULTI=true
LLM_CONSULT_MAX_ENGINES=2
LLM_CONSULT_MODE=panel
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_CIRCUIT_COOLDOWN_MAX_SECONDS=300
LLM_LOCAL_MAX_CONCURRENCY=2
LLM_REASONING_COMPUTE_CLASS=deep
LLM_RECOVERY_PROBE_SECONDS=60
LLM_ACKNOWLEDGE_SINGLE_PROVIDER=false
LIGHTNING_OLLAMA_URL=

# Optional local request/token-budget limits. Uncomment and set positive values
# based on the actual API plan. A value of 0 means unmetered in the local budget
# guard; do not assume these values are the provider's published quotas.
# LLM_RPM=10
# LLM_RPD=500
# LLM_TPM=50000
# LLM_TPD=500000

# Optional provider credentials. Supply only the keys for the providers used by
# LLM_PROVIDER / LLM_EXTRA_MODELS; key aliases are listed for provider compatibility.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
PPLX_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
TOGETHERAI_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
CEREBRAS_API_KEY=
HUGGINGFACE_API_KEY=
HF_TOKEN=
NVIDIA_API_KEY=
NIM_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GMI_API_KEY=
GMI_CLOUD_API_KEY=
MODAL_API_KEY=
MODAL_INFERENCE_KEY=
ANYSCALE_API_KEY=
REPLICATE_API_KEY=
REPLICATE_API_TOKEN=
BLUESMINDS_API_KEY=

# =============================================================================
# 5. Composio external action / knowledge integrations
# =============================================================================
# Set COMPOSIO_API_KEY in the private .env before using live external actions.
# With COMPOSIO_ENABLED=true and COMPOSIO_DRY_RUN=false, a missing key must
# report the adapter as unavailable; it must not be treated as mock success.
COMPOSIO_ENABLED=true
COMPOSIO_DRY_RUN=false
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_ENTITY_ID=default
COMPOSIO_API_VERSION=v3
COMPOSIO_TRANSPORT=mcp
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
COMPOSIO_MCP_AUTH_HEADER=x-consumer-api-key
COMPOSIO_MCP_ROUTER_TOOL=COMPOSIO_MULTI_EXECUTE_TOOL
# These router-field names default to tools / tool_slug / arguments in the source.
# They are optional schema overrides; uncomment only when your Composio endpoint differs.
# COMPOSIO_MCP_ROUTER_TOOLS_KEY=tools
# COMPOSIO_MCP_ROUTER_SLUG_KEY=tool_slug
# COMPOSIO_MCP_ROUTER_ARGS_KEY=arguments
COMPOSIO_AUTO_MAX_RISK=medium
COMPOSIO_MIN_CONFIDENCE=0.2
COMPOSIO_MEDIUM_CONFIDENCE_THRESHOLD=0.7
COMPOSIO_TIMEOUT_SECONDS=30
COMPOSIO_REQUIRE_SOURCE=true
COMPOSIO_KNOWLEDGE_ENABLED=true
COMPOSIO_ADVISOR_ENABLED=true
COMPOSIO_KNOWLEDGE_INTERVAL_SECONDS=300
COMPOSIO_KNOWLEDGE_MAX_ITEMS=5
COMPOSIO_AVAILABLE_PROVIDERS=composio_search,alphavantage,coinmarketcal,openrouter,gmail,notion,googledrive,github
COMPOSIO_PROVIDER_PREFERENCES=knowledge.retrieve=alphavantage,advisor.consult=openrouter,operator.notify=gmail
COMPOSIO_KNOWLEDGE_ARG_OVERRIDES=

# =============================================================================
# 6. API control plane and instance management
# =============================================================================
# APEX_API_DATA_DIR is the API's own database/secret directory, not APEX_DATA_DIR.
# Blank uses the application default under api_data/.
APEX_API_DATA_DIR=
APEX_API_HOST=127.0.0.1
APEX_API_PORT=8080
APEX_API_JWT_SECRET=
APEX_API_VAULT_KEY=
APEX_API_ACCESS_TTL_MIN=30
APEX_API_REFRESH_TTL_DAYS=7
APEX_API_RESET_TTL_MIN=30
APEX_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://apex-trader.live,https://www.apex-trader.live
APEX_API_AUTH_RATE_MAX=10
APEX_API_AUTH_RATE_WINDOW=60
APEX_API_MAX_INSTANCES=50
APEX_API_STOP_GRACE_SEC=15
APEX_API_PYTHON=
APEX_API_DATA_SYNC=true
APEX_API_DATA_SYNC_BRANCH=main
APEX_API_DATA_SYNC_INTERVAL=3600

# =============================================================================
# 7. Dashboard and Datadog observability
# =============================================================================
DD_DASHBOARD_BIND_HOST=127.0.0.1
DD_DASHBOARD_PORT=8000
DD_DASHBOARD_API_KEY=
DD_DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DD_DASHBOARD_TRUST_LOOPBACK=true

DD_API_KEY=
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
DD_ENV=development
DD_SERVICE=apex-trader
DD_LOGS_INJECTION=true

# =============================================================================
# 8. ChatGPT signal relay and optional Binance adapter
# =============================================================================
# This is a separate signal adapter, not the CognitiveBrain's broker authority.
# Keep it in PAPER mode until its identity/risk path is separately validated.
CHATGPT_RELAY_TOKEN=
CHATGPT_RELAY_HOST=127.0.0.1
CHATGPT_RELAY_PORT=8790
CHATGPT_SIGNAL_TIMEOUT_SECONDS=90
APEX_REPO=Eugine336/apex-trader
CHATGPT_SIGNAL_BRANCH=chatgpt-signal-inbox
CHATGPT_SIGNAL_POLL_SECONDS=3
CHATGPT_SIGNAL_WORKTREE=.runtime/chatgpt-signal-inbox
CHATGPT_ALLOW_DUPLICATES=false

BINANCE_EXECUTION_MODE=PAPER
BINANCE_LIVE_EXECUTION_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MAX_NOTIONAL_USDT=100
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
MAX_SIMULTANEOUS_POSITIONS=3
MAX_ACCOUNT_RISK_PERCENT=1.0


# =============================================================================
# 9. Configuration authority and dashboard control contract
# =============================================================================
# All supported operator-configurable startup/deployment settings consumed by
# Apex must be documented in this template. New environment reads require a
# matching .env.example update and configuration tests in the same change.
#
# Dashboard listener and remote-control security:
# DD_DASHBOARD_BIND_HOST=127.0.0.1
# DD_DASHBOARD_PORT=8000
# DD_DASHBOARD_API_KEY=
# DD_DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DD_DASHBOARD_TRUST_LOOPBACK=false
#
# The dashboard API key is required for remote mutating dashboard requests.
# Loopback trust is opt-in and must remain disabled behind a reverse proxy.
# APEX_API_JWT_SECRET and APEX_API_VAULT_KEY belong to the separate multi-user
# API control plane; they are not interchangeable with the dashboard API key.
#
# IMPORTANT CONFIGURATION BOUNDARY:
# - .env configures process startup/deployment. Changes require a controlled
#   restart/redeploy; the dashboard must never edit or rewrite .env.
# - Runtime dashboard actions must use authenticated, authorized, validated
#   API operations and durable state, with audit records.
# - Identity rules, Brain decision authority, evidence requirements and
#   mandatory execution/risk safeguards are invariants, not overrideable knobs.
# - Blank provider credentials do not mean a provider is connected or entitled.
# - Never put real secrets, broker credentials, account identifiers or tokens
#   in this template.

