{
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        ".",
        "brain",
        "scanner",
        "trigger",
        "management",
        "platforms",
        "risk"
      ]
    }
  ],
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "reportMissingDefaultExcludes": "none",
  "exclude": [
    "**/__pycache__",
    "**/*.pyc",
    "**/node_modules",
    "**/.git"
  ]
}